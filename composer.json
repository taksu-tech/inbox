{
    "name": "taksu-tech/taksu-inbox",
    "description": "Laravel package for managing inbox notifications with FCM support",
    "keywords": ["laravel", "inbox", "notifications", "fcm", "firebase"],
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Taksu\\TaksuInbox\\": "app/"
        }
    },
    "authors": [
        {
            "name": "Made Adi",
            "email": "made.adi@taksu.tech"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "laravel-notification-channels/fcm": "^5.1"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "barryvdh/laravel-ide-helper": "^3.6"
    }
}
